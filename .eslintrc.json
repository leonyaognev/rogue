{
  "extends": "airbnb-base",
  "env": {
    "node": true,
    "es2024": true
  },
  "parserOptions": {
    "ecmaVersion": 2024,
    "sourceType": "module"
  },
  "rules": {
    "no-console": "warn",
    "no-plusplus": "off",
    "no-continue": "off",
    "class-methods-use-this": "off",
    "no-bitwise": "off",
    "import/extensions": [
      "error",
      "always",
      {
        "js": "always"
      }
    ],
    "no-restricted-syntax": "off",
    "no-unused-vars": "warn"
  }
}
